Depends: libc6 (>= 2.34), libcups2t64 (>= 1.4.0), libgcc-s1 (>= 3.3.1), libqt6concurrent6 (>= 6.1.2), libqt6core6t64 (>= 6.9.1), libqt6dbus6 (>= 6.1.2), libqt6gui6 (>= 6.8.2), libqt6printsupport6 (>= 6.1.2), libqt6sql6 (>= 6.1.2), libqt6widgets6 (>= 6.3.0), libstdc++6 (>= 14), libsynctex2 (>= 2025.20250727.75242+ds), hicolor-icon-theme, libqt6sql6-sqlite, libqt6svg6, qpdfview-pdf-poppler-plugin
