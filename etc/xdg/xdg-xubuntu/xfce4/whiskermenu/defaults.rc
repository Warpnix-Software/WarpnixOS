name[pl]=Otwórz adres URI
name[pt]=Abrir URI
name[pt_BR]=Abrir URI
name[ru]=Открыть URI
name[sv]=Öppna URI
name[th]=เปิด URI
name[tr]=Bağlantıyı Aç
name[uk]=Відкрити посилання
