button-icon=xubuntu-logo-menu
show-button-title=false
show-button-icon=true
load-hierarchy=true
launcher-show-name=true
launcher-show-description=false
item-icon-size=1
category-icon-size=0
hover-switch-category=false
favorites-in-recent=true
display-recent-default=false
position-search-alternate=true
command-switchuser=dm-tool switch-to-greeter
show-command-switchuser=false
command-settings=xfce4-settings-manager
show-command-settings=true
command-menueditor=menulibre
show-command-menueditor=true
command-lockscreen=xflock4
show-command-lockscreen=true
command-logout=xfce4-session-logout
show-command-logout=true
search-actions=5

[action0]
name=Man Pages
name[ar]=صفحات دليل المستخدم Man
name[de]=Hauptseiten
name[es]=Páginas de manual
name[et]=Rakenduste abiteave
name[fr]=Man Pages
name[gl]=Páxinas de manual
name[he]=עמודי הסבר
name[id]=Halaman Man
name[ja]=メインページ
name[ka]=დოკუმენტაციის გვერდები
name[kk]=Көмек (man) беттері
name[lt]=Vadovo puslapiai
name[oc]=Paginas principalas
name[pl]=Strony podręcznika
name[pt]=Páginas de manual
name[pt_BR]=Páginas de manuais
name[ru]=Страницы man
name[sv]=Huvudsidor
name[th]=หน้าคู่มือ
name[tr]=El Kitabı
name[uk]=Сторінки Man
pattern=#
command=exo-open --launch TerminalEmulator man %s
regex=false

[action1]
name=Wikipedia
name[ar]=ويكيبيديا
name[de]=Wikipedia
name[es]=Wikipedia
name[et]=Vikipeedia
name[fr]=Wikipedia
name[gl]=Wikipedia
name[he]=ויקיפדיה
name[id]=Wikipedia
name[ja]=Wikipedia
name[ka]=Wikipedia - უფასო ენციკლოპედია
name[kk]=Википедия
name[lt]=Vikipedija
name[oc]=Wikipèdia
name[pl]=Wikipedia
name[pt]=Wikipédia
name[pt_BR]=Wikipédia
name[ru]=Википедия
name[sv]=Wikipedia
name[th]=วิกิพีเดีย
name[tr]=Wikipedia
name[uk]=Вікіпедія
pattern=!w
command=exo-open --launch WebBrowser https://en.wikipedia.org/wiki/%u
regex=false

[action2]
name=Run in Terminal
name[ar]=فتح في المحطة الطرفية
name[de]=Im Terminal öffnen
