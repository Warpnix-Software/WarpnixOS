favorites=xfce4-web-browser.desktop,xfce4-mail-reader.desktop,xfce4-file-manager.desktop,libreoffice-writer.desktop,libreoffice-calc.desktop,snap-store_snap-store.desktop,xfce4-terminal-emulator.desktop,xfhelp4.desktop
button-title=Applications Menu
button-title[ar]=قائمة التطبيقات
button-title[de]=Anwendungsmenü
button-title[es]=Menú de aplicaciones
button-title[et]=Rakenduste menüü
button-title[fr]=Menu Applications
button-title[gl]=Menu de aplicacións
button-title[he]=תפריט יישומים
button-title[id]=Menu Aplikasi
button-title[ja]=アプリケーションメニュー
button-title[ka]=პროგრამების მენიუ
button-title[kk]=Қолданбалар мәзірі
button-title[lt]=Programų meniu
button-title[oc]=Menut d’aplicacions
button-title[pl]=Menu programów
button-title[pt]=Menu de Aplicações
button-title[pt_BR]=Menu de Aplicações
button-title[ru]=Меню приложений
button-title[sv]=Program meny
button-title[th]=เมนูโปรแกรม
button-title[tr]=Uygulamalar Menüsü
