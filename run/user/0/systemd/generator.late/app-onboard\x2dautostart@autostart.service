# Automatically generated by systemd-xdg-autostart-generator

[Unit]
Documentation=man:systemd-xdg-autostart-generator(8)
SourcePath=/etc/xdg/autostart/onboard-autostart.desktop
PartOf=graphical-session.target

Description=Onboard
After=graphical-session.target

[Service]
Type=exec
ExitType=cgroup
ExecStart=:/usr/bin/onboard --not-show-in=GNOME,GNOME-Classic:GNOME --startup-delay=3.0
Restart=no
TimeoutStopSec=5s
Slice=app.slice
ExecCondition=/usr/lib/systemd/systemd-xdg-autostart-condition "Unity:MATE" ""
