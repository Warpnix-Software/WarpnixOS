  </tr>
  <tr xml:id="mail-arrow-down">
    <td><p><key>↓</key></p></td>
    <td><p>Joan hurrengo mezura.</p></td>
  </tr>
  <tr xml:id="mail-arrow-up">
    <td><p><key>↑</key></p></td>
    <td><p>Joan aurreko mezura.</p></td>
  </tr>
  <tr xml:id="mail-dot">
    <td><p><key>.</key> edo <key>]</key></p></td>
