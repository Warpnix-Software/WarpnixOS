  </indexterm> 

  <!-- ============= Document Body ============================= -->
  <sect1 id="tool-introduction"> 
    <title>Úvod</title> 
    <para><application>Nástroj pro správu času</application> vám umožňuje nastavit čas, datum a časové pásmo ve vašem systému, stejně jako časové servery, podle kterých se budou synchronizovat váše hodiny.</para> 
  </sect1>

  <sect1 id="tool-getting-started">
    <title>Začínáme</title>

    <para><application>Nástroj pro správu času</application> můžete spustit následujícími způsoby:</para>

    <variablelist>
	 <varlistentry>
	   <term>Nabídka <guimenu>Systém</guimenu></term>
	   <listitem>
		<para>Zvolte <menuchoice><guisubmenu>Správa</guisubmenu><guimenuitem>Datum a čas</guimenuitem></menuchoice>.</para>
	   </listitem>
	 </varlistentry>

	 <varlistentry>
	   <term>Kontextová nabídka appletu Hodiny</term>
	   <listitem>
		<para>Zvolte <menuchoice><guisubmenu>Upravit datum a čas</guisubmenu></menuchoice>.</para>
	   </listitem>
	 </varlistentry>

	 <varlistentry>
	   <term>Příkazový řádek</term>
	   <listitem>
		<para>Spusťte následující příkaz: <command>time-admin</command></para>
	   </listitem>
	 </varlistentry>
    </variablelist>

    <para>Když spustíte <application>Nástroj pro správu času</application>, budete dotázáni na heslo správce. To je nutné, protože změny provedené tímto nástrojem ovlivní celý systém.</para>

    <para>Po zadání hesla správce se zobrazí okno pro nastavení času.</para>

    <figure id="time-main-window-automatic">
	 <title>Hlavní okno Nástroje pro správu času, režim automatického nastavení</title>
	 <screenshot>
	   <mediaobject lang="en">
		<imageobject>
		  <imagedata fileref="figures/time-tool-automatic.png" format="PNG"/>
		</imageobject>
		<textobject>
		  <phrase>Shows Time Administration Tool main window, automatic configuration mode.</phrase>
		</textobject>
	   </mediaobject>
	 </screenshot>
    </figure>

    <figure id="time-main-window-manual">
	 <title>Hlavní okno Nástroje pro správu času, režim ručního nastavení</title>
	 <screenshot>
	   <mediaobject lang="en">
		<imageobject>
		  <imagedata fileref="figures/time-tool-manual.png" format="PNG"/>
		</imageobject>
		<textobject>
		  <phrase>Shows Time Administration Tool main window, manual configuration mode.</phrase>
		</textobject>
	   </mediaobject>
	 </screenshot>
    </figure>

    <para>Hlavní okno <application>Nástroje pro správu času</application> obsahuje následující části:</para>

    <variablelist>
	 <varlistentry>
	   <term>Časové pásmo</term>
	   <listitem>
		<para>Zobrazuje vaše současné časové pásmo, po zmáčknutí se objeví mapa, na které si můžete časové pásmo zvolit.</para>
	   </listitem>
	 </varlistentry>

	 <varlistentry>
	   <term>Nastavení</term>
	   <listitem>
	     <para>Může být jedno z těchto dvou:</para>
	     <variablelist>
	       <varlistentry>
	         <term lang="en"><guilabel>Keep synchronized with Internet servers</guilabel></term>
		 <listitem>
		   <para>Budete si moci zvolit ze seznamu Internetových serverů, podle kterých se budou vaše hodiny v počítači automaticky synchronizovat.</para>
		 </listitem>
	       </varlistentry>
	       <varlistentry>
	         <term lang="en"><guilabel>Manual</guilabel></term>
		 <listitem>
		   <para>Budete si moci datum a čas zadat ručně sami.</para>
		 </listitem>
	       </varlistentry>
	     </variablelist>
	   </listitem>
	 </varlistentry>

	 <varlistentry>
	   <term>Tlačítko <guilabel>Synchronizovat nyní</guilabel></term>
	   <listitem>
		<para>Tímto tlačítkem ihned provedete synchronizaci podle vybraných Internetových serverů.</para>
	   </listitem>
	 </varlistentry>
    </variablelist>
  </sect1>

  <sect1 id="tool-usage">
    <title>Použití</title>

    <sect2>
	 <title>Změna vašeho času a data</title>
	 <para>Změňte čas pomocí číselníků a datum pomocí kalendáře.</para>
    </sect2>

    <sect2 id="tool-time-zone">
	 <title>Změna vašeho časového pásma</title>
	 <para>Klikněte na tlačítko <guilabel>Časové pásmo</guilabel> a zvolte si na mapě novou pozici, nebo ji případně můžete vybrat ze seznamu pod mapou.</para>

	 <figure id="time-map-window">
	   <title>Mapa v Nástroji pro správu času</title>
	   <screenshot>
		<mediaobject lang="en">
		  <imageobject>
		    <imagedata fileref="figures/time-map.png" format="PNG"/>
		  </imageobject>
		  <textobject>
		    <phrase>Shows Time Administration Tool map window.</phrase>
		  </textobject>
		</mediaobject>
	   </screenshot>
	 </figure>
    </sect2>

    <sect2 id="tool-time-servers">
	 <title>Synchronizace vašeho místního času s Internetovými časovými servery </title>
	 <para>Pokud není server povolen, můžete tak učinit kliknutím na příslušné zaškrtávací políčko v <guilabel>Seznamu serverů</guilabel>.</para>

	 <figure id="time-servers-window">
	   <title>Okno se servery v Nástroji pro správu času</title>
	   <screenshot>
		<mediaobject lang="en">
		  <imageobject>
		    <imagedata fileref="figures/time-servers.png" format="PNG"/>
		  </imageobject>
		  <textobject>
		    <phrase>Shows Time Administration Tool servers window.</phrase>
		  </textobject>
		</mediaobject>
	   </screenshot>
	 </figure>
    </sect2>
  </sect1>
