  </tr>
  <tr xml:id="calendar-ctrl-k">
    <td><p><keyseq><key>Ctrl</key><key>K</key></keyseq></p></td>
    <td><p>Обзор недели</p></td>
  </tr>
  <tr xml:id="calendar-ctrl-m">
    <td><p><keyseq><key>Ctrl</key><key>M</key></keyseq></p></td>
    <td><p>Обзор месяца</p></td>
  </tr>
  <tr xml:id="calendar-ctrl-l">
    <td><p><keyseq><key>Ctrl</key><key>L</key></keyseq></p></td>
    <td><p>Обзор списка</p></td>
  </tr>
</table>
</section>

<section id="contacts">
<title>Контакты</title>
<table rules="rows" frame="top bottom">
  <tr xml:id="contacts-shift-ctrl-c">
    <td><p><keyseq><key>Shift</key><key>Ctrl</key><key>C</key></keyseq></p></td>
    <td><p>Создать новый контакт.</p></td>
  </tr>
  <tr xml:id="contacts-shift-ctrl-l">
    <td><p><keyseq><key>Shift</key><key>Ctrl</key><key>L</key></keyseq></p></td>
    <td><p>Создать новый список контактов.</p></td>
