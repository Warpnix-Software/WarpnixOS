  </tr>
  <tr xml:id="calendar-ctrl-g">
    <td><p><keyseq><key>Ctrl</key><key>G</key></keyseq></p></td>
    <td><p>Перейти к дате.</p></td>
  </tr>
  <tr xml:id="calendar-ctrl-y">
    <td><p><keyseq><key>Ctrl</key><key>Y</key></keyseq></p></td>
