  <!-- ============= Document Body ============================= -->
  <sect1 id="tool-introduction"> 
    <title>Uvod</title> 
    <para lang="en">The <application>Services Administration Tool</application> allows you to specify which services will be started during the system boot process.</para>
  </sect1>

  <sect1 id="tool-getting-started">
    <title lang="en">Getting started</title>

    <para lang="en">You can start <application>Services Administration Tool</application> in the following ways:</para>

    <variablelist>
	 <varlistentry>
	   <term lang="en"><guimenu>System</guimenu> menu</term>
	   <listitem>
		<para lang="en">Choose <menuchoice><guisubmenu>Administration</guisubmenu><guimenuitem>Services</guimenuitem></menuchoice>.</para>
	   </listitem>
	 </varlistentry>

	 <varlistentry>
	   <term>Ukazna vrstica</term>
	   <listitem>
		<para lang="en">Execute the following command: <command>services-admin</command></para>
	   </listitem>
	 </varlistentry>
    </variablelist>

    <para lang="en">When you start <application>Services Administration Tool</application>, you will be prompted for the administrator password, this is necessary because the changes done with this tool will affect the whole system.</para>

    <para lang="en">After entering the administrator password, the following window is displayed.</para>

    <figure id="services-main-window">
	 <title lang="en">Services Administration Tool main window</title>
	 <screenshot>
	   <mediaobject lang="en">
		<imageobject>
		  <imagedata fileref="figures/services-tool.png" format="PNG"/>
		</imageobject>
		<textobject>
		  <phrase>Shows Services Administration Tool main window.</phrase>
		</textobject>
	   </mediaobject>
	 </screenshot>
    </figure>

    <para lang="en">The <application>Services Administration Tool</application> main window contains the following elements:</para>

    <variablelist>
	 <varlistentry>
	   <term>Seznam storitev</term>
	   <listitem>
		<para lang="en">This is a list of the main services installed in the system, the checkbox indicates whether the service is active or not.</para>
	   </listitem>
	 </varlistentry>
    </variablelist>
  </sect1>

  <sect1 id="tool-usage">
    <title>Uporaba</title>

    <sect2>
	 <title lang="en">To enable or disable a service at boot time</title>
	 <para lang="en">Enable or disable the checkbox beside the service in the services list.</para>
    </sect2>
  </sect1>
